TELEGRAM_BOT_TOKEN=your_bot_token_here
# Single chat ID or comma-separated list of User / Group IDs (e.g. 123456789,-1001234567890)
TELEGRAM_CHAT_ID=your_chat_id_here
GEMINI_API_KEY=your_gemini_api_key_here
ONLINEJOBS_COOKIE=your_onlinejobs_cookie_here
# Optional: Hours to look back for jobs. Defaults to 24 (recommended buffer for 6h crons).
# If you want a tighter window, you can set it to 8 or 12.
LOOKBACK_HOURS=24
